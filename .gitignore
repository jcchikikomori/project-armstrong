# Secrets: DB password, JWT signing key, DuckDNS token (a DNS takeover credential).
.env
deploy/.env
**/.env
!deploy/.env.example

# Runtime state that belongs on the droplet, not in git.
deploy/data/

# datasets in a CSV format
datasets/*.csv
!datasets/.gitinclude

# Derived JSON and the import ledger: the same medical records in a different
# shape, plus persona.csv content that should not leave this machine.
datasets/derived/
