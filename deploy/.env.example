# Copy to .env and fill in. deploy.sh generates this file for you with strong
# random secrets; this template is for manual setups and for reference.
#
# chmod 600 .env -- it holds the database password, the JWT signing key, and a
# DuckDNS token that can repoint your subdomain.

# --- Domain / TLS ---
DOMAIN=nan0machin3s.duckdns.org
ACME_EMAIL=you@example.com

# --- DuckDNS ---
# Subdomain is the label only, without .duckdns.org
DUCKDNS_SUBDOMAIN=nan0machin3s
DUCKDNS_TOKEN=your-duckdns-token

# --- Database ---
DB_NAME=medical_records
DB_USER=medapp
# Compose expands $ and treats an unquoted # as a comment. Generated passwords
# strip both characters rather than relying on escaping.
DB_PASSWORD=replace-me

# --- App ---
# Required. Without it the app generates an ephemeral key and every restart
# invalidates all sessions.
SECRET_KEY=replace-with-32-random-bytes-hex
# Required here. Upstream defaults it to admin123, which is not acceptable on a
# public host.
ADMIN_DEFAULT_PASSWORD=replace-me
DEBUG=false
ENABLE_API_DOCS=false
LOG_LEVEL=INFO
TZ=Asia/Singapore
# Australia/Perth is the same UTC+8 with no DST if you prefer that label.
ALLOW_PRIVATE_INTEGRATION_URLS=false

# --- Host user for bind mounts ---
PUID=1000
PGID=1000

# --- JSON export ---
EXPORT_RETENTION_DAYS=14
